---
import { computeCompositedTimelineLayout, DEFAULT_GEOMETRY } from './paginationGeometry';
import { DEFAULT_LOCALE, getUIText, type Locale } from '@lib/i18n';
import '@styles/modules/post-view-timeline.css';

interface Props {
    totalItems: number;
    locale?: Locale;
}

const { totalItems, locale = DEFAULT_LOCALE } = Astro.props;
const initialTimeline = computeCompositedTimelineLayout(
    totalItems,
    0,
    totalItems > 0 ? [0] : [],
    DEFAULT_GEOMETRY
);
const galleryListLabel = getUIText('postView', 'galleryListLabel', locale);
const scrollLeftLabel = getUIText('postView', 'scrollLeft', locale);
const scrollRightLabel = getUIText('postView', 'scrollRight', locale);
const statusTemplate = getUIText('postView', 'browsingStatus', locale);
const currentPostTemplate = getUIText('postView', 'currentPost', locale);
const jumpToPostTemplate = getUIText('postView', 'jumpToPost', locale);
const formatTemplate = (template: string, current: number) =>
    template.replace('{current}', String(current)).replace('{total}', String(totalItems));
---

<div
    class="post-view-scroll-wrapper relative flex w-full flex-col"
    data-post-view-gallery
    data-post-view-status-template={statusTemplate}
    data-post-view-current-label-template={currentPostTemplate}
    data-post-view-jump-label-template={jumpToPostTemplate}
>
    <div data-view-motion-content class="post-view-main-viewport relative">
        <div
            aria-hidden="true"
            data-post-view-mask="left"
            data-can-scroll="false"
            class="post-view-scroll-mask post-view-scroll-mask-left pointer-events-none absolute top-0 left-0 z-10 h-full w-20 sm:w-24 lg:w-28"
        >
        </div>
        <div
            aria-hidden="true"
            data-post-view-mask="right"
            data-can-scroll="false"
            class="post-view-scroll-mask post-view-scroll-mask-right pointer-events-none absolute top-0 right-0 z-10 h-full w-20 sm:w-24 lg:w-28"
        >
        </div>

        <button
            type="button"
            data-post-view-scroll-control="left"
            data-can-scroll="false"
            tabindex="-1"
            class="post-view-scroll-control post-view-scroll-control-left absolute top-1/2 left-4 z-20 flex h-12 w-12 -translate-y-1/2 items-center justify-center rounded-full border border-[var(--border)] bg-[var(--background)]/80 shadow-lg backdrop-blur-sm"
            aria-label={scrollLeftLabel}
            aria-hidden="true"
        >
            <svg
                aria-hidden="true"
                viewBox="0 0 24 24"
                class="h-6 w-6"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
            >
                <path d="m15 18-6-6 6-6"></path>
            </svg>
        </button>

        <button
            type="button"
            data-post-view-scroll-control="right"
            data-can-scroll="false"
            tabindex="-1"
            class="post-view-scroll-control post-view-scroll-control-right absolute top-1/2 right-4 z-20 flex h-12 w-12 -translate-y-1/2 items-center justify-center rounded-full border border-[var(--border)] bg-[var(--background)]/80 shadow-lg backdrop-blur-sm"
            aria-label={scrollRightLabel}
            aria-hidden="true"
        >
            <svg
                aria-hidden="true"
                viewBox="0 0 24 24"
                class="h-6 w-6"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
            >
                <path d="m9 18 6-6-6-6"></path>
            </svg>
        </button>

        <div
            data-post-view-scroll
            class="post-view-scroll-container flex h-full touch-pan-x snap-x snap-mandatory items-center gap-[60px] overflow-x-auto py-4 [padding-right:clamp(1rem,5vw,60px)] [padding-left:clamp(1rem,5vw,60px)] [-ms-overflow-style:none] [scrollbar-width:none] [&_.post-card-wrapper]:snap-center [&::-webkit-scrollbar]:hidden"
            role="list"
            aria-label={galleryListLabel}
        >
            <slot />
        </div>
    </div>

    <div
        data-post-view-overview
        class="pvp-overview pointer-events-none hidden lg:fixed lg:right-0 lg:bottom-0 lg:left-0 lg:z-[55] lg:block"
        aria-hidden="true"
    >
        <div data-post-view-overview-bloom class="pvp-overview-bloom"></div>
        <div data-post-view-overview-core class="pvp-overview-core"></div>
        <div data-post-view-overview-head class="pvp-overview-head"></div>
    </div>

    <div
        data-post-view-pagination
        class="post-view-pagination pvp-cluster group 3xl:px-16 relative w-full overflow-visible pt-1 lg:fixed lg:bottom-0 lg:left-0 lg:z-[60] lg:min-h-[var(--site-dock-height)] lg:w-1/3 lg:items-center lg:px-8 lg:pt-0 lg:pb-4 xl:px-10 2xl:px-12"
    >
        <span data-post-view-status class="sr-only">
            {formatTemplate(statusTemplate, 1)}
        </span>
        <div class="pvp-timeline">
            <div class="pvp-aura" aria-hidden="true"></div>
            <div
                data-post-view-track
                class="pvp-track"
                style={`--pvp-track-x: ${initialTimeline.translateX.toFixed(2)}px`}
            >
                {
                    initialTimeline.markers.map((marker, index) => (
                        <button
                            type="button"
                            data-post-view-marker={index}
                            class:list={['pvp-marker', marker.isActive && 'is-active']}
                            style={`--pvp-marker-scale: ${marker.scaleX.toFixed(4)}; opacity: ${marker.opacity.toFixed(3)}; pointer-events: ${marker.inWindow ? 'auto' : 'none'}`}
                            tabindex={marker.inWindow ? '0' : '-1'}
                            aria-hidden={marker.inWindow ? undefined : 'true'}
                            aria-current={marker.isActive ? 'true' : undefined}
                            aria-label={
                                marker.isActive
                                    ? formatTemplate(currentPostTemplate, index + 1)
                                    : formatTemplate(jumpToPostTemplate, index + 1)
                            }
                        />
                    ))
                }
            </div>
        </div>
    </div>
</div>

<style>
    .post-view-scroll-mask {
        opacity: 0;
        transition: opacity 250ms ease;
        mask-image: linear-gradient(
            to bottom,
            transparent 0%,
            black 8%,
            black 92%,
            transparent 100%
        );
    }

    .post-view-scroll-mask[data-can-scroll='true'] {
        opacity: 1;
    }

    .post-view-scroll-mask-left {
        background: linear-gradient(
            to right,
            var(--post-view-scroll-mask-start) 0%,
            var(--post-view-scroll-mask-end) 100%
        );
    }

    .post-view-scroll-mask-right {
        background: linear-gradient(
            to left,
            var(--post-view-scroll-mask-start) 0%,
            var(--post-view-scroll-mask-end) 100%
        );
    }

    .post-view-scroll-control {
        pointer-events: none;
        opacity: 0;
        transition:
            opacity 200ms ease,
            transform 200ms ease,
            background-color 200ms ease;
    }

    .post-view-scroll-control-left {
        transform: translate(0.5rem, -50%);
    }

    .post-view-scroll-control-right {
        transform: translate(-0.5rem, -50%);
    }

    .post-view-scroll-control[data-can-scroll='true']:focus-visible {
        pointer-events: auto;
        opacity: 1;
        transform: translate(0, -50%);
    }

    @media (hover: hover) and (pointer: fine) {
        [data-post-view-gallery]:hover .post-view-scroll-control[data-can-scroll='true'] {
            pointer-events: auto;
            opacity: 1;
            transform: translate(0, -50%);
        }

        .post-view-scroll-control[data-can-scroll='true']:hover {
            background-color: var(--background);
            transform: translate(0, -50%) scale(1.1);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .post-view-scroll-mask,
        .post-view-scroll-control {
            transition: none;
        }
    }
</style>
